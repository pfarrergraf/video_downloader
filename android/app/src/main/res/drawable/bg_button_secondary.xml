<?xml version="1.0" encoding="utf-8"?>
<!-- Lower-emphasis action pill on opaque dark backgrounds: "Library" (home),
     "Load more" (media search screen). Matches the bg_media_card style. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_dark">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="@color/border_card" />
        </shape>
    </item>
</ripple>

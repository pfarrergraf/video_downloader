<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass pill for controls floating over the video surface itself
     (player_history/player_search/player_speed/player_sleep), where an
     opaque card color would look out of place over moving video. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_dark">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#73000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</ripple>

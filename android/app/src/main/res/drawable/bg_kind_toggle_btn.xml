<?xml version="1.0" encoding="utf-8"?>
<!-- Same visual language as the web UI's share-format picker
     (#share-format-overlay .kind-toggle in static/index.html): a big,
     emoji-labelled pill button rather than a plain system Button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#241f3d" />
    <stroke android:width="1dp" android:color="#3d3768" />
    <corners android:radius="14dp" />
</shape>

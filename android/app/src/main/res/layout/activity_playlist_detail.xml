<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11101c"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/playlist_detail_normal_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/playlist_detail_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/player_back"
                    android:src="@drawable/ic_player_back" />
            </FrameLayout>

            <TextView
                android:id="@+id/playlist_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3F1FB"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/playlist_detail_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="48dp"
            android:textColor="#A5A0C0"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/playlist_detail_play"
                style="@style/Widget.ClassyDL.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/library_playlist_quick_play" />

            <Button
                android:id="@+id/playlist_detail_shuffle"
                style="@style/Widget.ClassyDL.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/playlist_detail_shuffle" />

            <Button
                android:id="@+id/playlist_detail_repeat"
                style="@style/Widget.ClassyDL.Button.Secondary"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="0dp"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Selection-mode header: replaces playlist_detail_normal_header while
         any track is checked. -->
    <LinearLayout
        android:id="@+id/playlist_detail_selection_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/playlist_detail_selection_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/playlist_detail_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/playlist_detail_selection_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_playlist_quick_play"
            android:padding="8dp"
            android:src="@drawable/ic_transport_play" />

        <ImageButton
            android:id="@+id/playlist_detail_selection_remove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_remove_from_playlist"
            android:padding="8dp"
            android:src="@drawable/ic_playlist_add" />

        <ImageButton
            android:id="@+id/playlist_detail_selection_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_selection_delete"
            android:padding="8dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <TextView
        android:id="@+id/playlist_detail_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/library_playlist_empty"
        android:textColor="#A5A0C0"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlist_detail_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_media_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/search_result_thumbnail"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:background="#1A1930"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/search_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:textColor="#F3F1FB"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/search_result_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#A5A0C0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/search_result_video"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:background="@drawable/bg_kind_toggle_btn"
            android:textColor="#F3F1FB"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:text="@string/search_download_video" />

        <Button
            android:id="@+id/search_result_audio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:background="@drawable/bg_kind_toggle_btn"
            android:textColor="#F3F1FB"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:text="@string/search_download_audio" />
    </LinearLayout>
</LinearLayout>
